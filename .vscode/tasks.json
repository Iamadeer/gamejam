{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-o", "bin/game",
                "src/*.cpp",
                "-I", "lib/raylib/src",
                "-L", "lib/raylib/build/raylib",
                "-lraylib",
                "-lGL", "-lm", "-lpthread", "-ldl", "-lrt",
                "-lX11"  // Sometimes needed for X11
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}